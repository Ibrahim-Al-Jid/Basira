{
  "version": "basira-phase12-holdout-1",
  "scope": "Synthetic defensive metadata and configuration. Documentary references; no executable OWASP Benchmark cases.",
  "references": [
    "https://owasp.org/projects/benchmark",
    "https://docs.docker.com/reference/dockerfile/#user",
    "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#permissions",
    "https://datatracker.ietf.org/doc/html/rfc6265",
    "https://osv.dev/vulnerability/GHSA-q2x7-8rv6-6q7h",
    "https://github.com/gitleaks/gitleaks"
  ],
  "ruleset": "basira-static-3",
  "tool_versions": {"gitleaks": "8.30.1", "osv-scanner": "2.7.1"},
  "osv_database_date": "2026-11-21",
  "thresholds": {
    "baseline_p95_ms": 300,
    "static_adapters_p95_ms": 22000,
    "fixture_enrichment_overhead_p95_ms": 150,
    "minimum_precision": 0.90,
    "minimum_recall": 0.90,
    "minimum_priority_accuracy_gain": 0.10,
    "maximum_duplicate_findings": 0,
    "maximum_failures": 0,
    "maximum_model_requests_per_scan": 1
  },
  "cases": [
    {
      "id": "support-readonly",
      "kind": "html",
      "name": "support.html",
      "artifact": "<main><h1>Support</h1><img src=\"https://cdn.example.test/status.png\" alt=\"Service status\"></main>",
      "expected": []
    },
    {
      "id": "member-address",
      "kind": "html",
      "name": "member.html",
      "artifact": "<main>\n<form action=\"http://member.example.test/signin\">\n<input type=\"password\" name=\"passphrase\">\n</form>\n</main>",
      "expected": [["http-form", "member.html", 2], ["HTML-17", "member.html", 2]],
      "priority_rule": "HTML-17"
    },
    {
      "id": "member-corrected",
      "kind": "html",
      "name": "member.html",
      "artifact": "<main>\n<form method=\"post\" action=\"https://member.example.test/signin\">\n<input type=\"password\" name=\"passphrase\">\n</form>\n</main>",
      "expected": []
    },
    {
      "id": "two-script-locations",
      "kind": "html",
      "name": "assets.html",
      "artifact": "<main>\n<script src=\"http://a.example.test/theme.js\"></script>\n<script src=\"http://b.example.test/layout.js\"></script>\n</main>",
      "expected": [["http-script", "assets.html", 2], ["http-script", "assets.html", 3]]
    },
    {
      "id": "desktop-session-capture",
      "kind": "har",
      "name": "session.har",
      "artifact": {"log": {"entries": [{"request": {"url": "https://portal.example.test/session", "method": "GET", "headers": []}, "response": {"status": 200, "headers": [{"name": "Set-Cookie", "value": "acceptance=synth-value; Path=/"}], "content": {"mimeType": "text/plain"}}}]}},
      "policy": {"session_cookie_names": ["acceptance"], "require_explicit_samesite": true},
      "expected": [["WEB-09", "capture.har", 1], ["WEB-10", "capture.har", 1], ["WEB-11", "capture.har", 1]],
      "priority_rule": "WEB-09"
    },
    {
      "id": "secured-session-capture",
      "kind": "har",
      "name": "session.har",
      "artifact": {"log": {"entries": [{"request": {"url": "https://portal.example.test/session", "method": "GET", "headers": []}, "response": {"status": 200, "headers": [{"name": "Set-Cookie", "value": "acceptance=synth-value; Secure; HttpOnly; SameSite=Lax; Path=/"}], "content": {"mimeType": "text/plain"}}}]}},
      "policy": {"session_cookie_names": ["acceptance"], "require_explicit_samesite": true},
      "expected": []
    },
    {
      "id": "release-user-root",
      "kind": "config",
      "name": "config.json",
      "artifact": {"files": {"release/Dockerfile": "# Release defaults\nFROM python@sha256:1111111111111111111111111111111111111111111111111111111111111111\nUSER 0\n"}},
      "expected": [["INF-01", "release/Dockerfile", 3]]
    },
    {
      "id": "release-user-nonroot",
      "kind": "config",
      "name": "config.json",
      "artifact": {"files": {"release/Dockerfile": "# Release defaults\nFROM python@sha256:2222222222222222222222222222222222222222222222222222222222222222\nUSER 1099\n"}},
      "expected": []
    },
    {
      "id": "payment-placeholder",
      "kind": "config",
      "name": "checkout.json",
      "artifact": {"files": {"checkout/settings.py": "# Fictional credential-shaped fixture\napi_key = \"basira_fixture_Q7vN4sB9xR2mK6pT8qW3\"\n"}},
      "expected": [["SRC-01", "checkout/settings.py", 2]]
    },
    {
      "id": "dependency-advisory-metadata",
      "kind": "config",
      "name": "dependency.json",
      "artifact": {"files": {"dependencies/requirements.txt": "# Resolved build requirements\nJinja2==3.1.4\n"}},
      "expected": [["SCA-01", "dependencies/requirements.txt", 2]],
      "expected_advisories": ["CVE-2024-56326"]
    },
    {
      "id": "dependency-without-pinned-advisory",
      "kind": "config",
      "name": "dependency.json",
      "artifact": {"files": {"dependencies/requirements.txt": "# Resolved build requirements\npackaging==26.2\n"}},
      "expected": []
    },
    {
      "id": "malformed-artifact",
      "kind": "config",
      "name": "invalid.json",
      "artifact": "{",
      "expected": [],
      "expect_rejection": true
    }
  ]
}
