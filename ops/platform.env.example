BASIRA_DB_PASSWORD=
BASIRA_DISPATCH_PASSWORD=
BASIRA_MIGRATION_PASSWORD=
BASIRA_PORT=8765
# Enable after verifying the ownership migration on a restored copy.
BASIRA_PERSONAL_PROJECTS=0
BASIRA_OIDC_ISSUER=
BASIRA_OIDC_CLIENT_ID=
BASIRA_OIDC_CLIENT_SECRET=
BASIRA_OIDC_REDIRECT_URI=http://127.0.0.1:8765/api/platform/auth/callback
BASIRA_OIDC_STATE_SECRET=
BASIRA_PASSWORD_AUTH_ENABLED=0
BASIRA_PASSWORD_SELF_SIGNUP=0
# Optional. Enable the model profile and then set the connection in Account.
BASIRA_PROJECT_MODEL_ENABLED=0
# Use http://model-gateway:8001, an independent gateway token and DB password.
BASIRA_GATEWAY_URL=
BASIRA_GATEWAY_TOKEN=
BASIRA_MODEL_DB_PASSWORD=
# Operator-managed fallback only. Allow explicit comma-separated organization IDs.
BASIRA_OPENROUTER_MODEL=
BASIRA_OPERATOR_MODEL_ORGS=
# compose.model.yaml reads openrouter.key from this private host directory.
BASIRA_OPENROUTER_SECRET_DIR=
# Default static project adapters. An empty value disables supplementary adapters.
BASIRA_SOURCE_ADAPTERS=gitleaks,osv-scanner
# Optional GitHub archive import via compose.github.yaml.
BASIRA_GITHUB_APP_ID=
BASIRA_GITHUB_APP_KEY_PATH=
BASIRA_GITHUB_INSTALLATIONS=
# Personal GitHub App. Keep expiring tokens and Contents read-only. Register this exact callback.
BASIRA_GITHUB_CLIENT_ID=
BASIRA_GITHUB_APP_SLUG=
BASIRA_GITHUB_CLIENT_SECRET=
BASIRA_GITHUB_CREDENTIAL_KEY=
BASIRA_GITHUB_CALLBACK_URL=http://127.0.0.1:8765/api/platform/github/callback
# Canonical HTTPS pages approved per project. Example: {"project_id":["https://example.com/"]}
BASIRA_APPROVED_WEBSITE_PAGES='{}'
# Private S3/MinIO quarantine bucket. Apply ops/intake-quarantine-lifecycle.json to the bucket.
BASIRA_INTAKE_S3_BUCKET=
BASIRA_INTAKE_S3_ENDPOINT=
BASIRA_INTAKE_STORAGE_REQUIRED=0
BASIRA_INTAKE_S3_REGION=us-east-1
BASIRA_INTAKE_S3_ACCESS_KEY_ID=
BASIRA_INTAKE_S3_SECRET_ACCESS_KEY=
BASIRA_INTAKE_S3_SESSION_TOKEN=
