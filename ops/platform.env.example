MARSAD_DB_PASSWORD=
MARSAD_DISPATCH_PASSWORD=
MARSAD_MIGRATION_PASSWORD=
MARSAD_PORT=8765
# Enable after verifying the ownership migration on a restored copy.
MARSAD_PERSONAL_PROJECTS=0
MARSAD_OIDC_ISSUER=
MARSAD_OIDC_CLIENT_ID=
MARSAD_OIDC_CLIENT_SECRET=
MARSAD_OIDC_REDIRECT_URI=http://127.0.0.1:8765/api/platform/auth/callback
MARSAD_OIDC_STATE_SECRET=
MARSAD_PASSWORD_AUTH_ENABLED=0
MARSAD_PASSWORD_SELF_SIGNUP=0
# Optional. Enable the model profile and then set the connection in Account.
MARSAD_PROJECT_MODEL_ENABLED=0
# Use http://model-gateway:8001, an independent gateway token and DB password.
MARSAD_GATEWAY_URL=
MARSAD_GATEWAY_TOKEN=
MARSAD_MODEL_DB_PASSWORD=
# Operator-managed fallback only. Allow explicit comma-separated organization IDs.
MARSAD_OPENROUTER_MODEL=
MARSAD_OPERATOR_MODEL_ORGS=
# compose.model.yaml reads openrouter.key from this private host directory.
MARSAD_OPENROUTER_SECRET_DIR=
# Default static project adapters. An empty value disables supplementary adapters.
MARSAD_SOURCE_ADAPTERS=gitleaks,osv-scanner
# Optional GitHub archive import via compose.github.yaml.
MARSAD_GITHUB_APP_ID=
MARSAD_GITHUB_APP_KEY_PATH=
MARSAD_GITHUB_INSTALLATIONS=
# Personal GitHub App. Keep expiring tokens and Contents read-only. Register this exact callback.
MARSAD_GITHUB_CLIENT_ID=
MARSAD_GITHUB_APP_SLUG=
MARSAD_GITHUB_CLIENT_SECRET=
MARSAD_GITHUB_CREDENTIAL_KEY=
MARSAD_GITHUB_CALLBACK_URL=http://127.0.0.1:8765/api/platform/github/callback
# Canonical HTTPS pages approved per project. Example: {"project_id":["https://example.com/"]}
MARSAD_APPROVED_WEBSITE_PAGES='{}'
# Private S3/MinIO quarantine bucket. Apply ops/intake-quarantine-lifecycle.json to the bucket.
MARSAD_INTAKE_S3_BUCKET=
MARSAD_INTAKE_S3_ENDPOINT=
MARSAD_INTAKE_STORAGE_REQUIRED=0
MARSAD_INTAKE_S3_REGION=us-east-1
MARSAD_INTAKE_S3_ACCESS_KEY_ID=
MARSAD_INTAKE_S3_SECRET_ACCESS_KEY=
MARSAD_INTAKE_S3_SESSION_TOKEN=
